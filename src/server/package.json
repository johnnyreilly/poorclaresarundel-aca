{
    "name": "poor-clares-arundel-koa-server",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "dev:build": "pnpm run build && pnpm run client",
        "dev": "pnpm run dev:build && pnpm start",
        "client": "pnpm run client:build && pnpm run client:copy",
        "client:build": "cd ../client && pnpm run build",
        "client:copy": "cpx \"../client/dist/**/*\" client/dist",
        "lint": "eslint ./src",
        "start": "node dist/index.js",
        "watch": "cross-env NODE_ENV=development nodemon --watch src/**/* -e ts,tsx --exec ts-node src/server/server.ts"
    },
    "dependencies": {
        "@fastify/helmet": "^13.2.0",
        "@fastify/static": "^11.0.0",
        "applicationinsights": "^3.17.1",
        "applicationinsights-native-metrics": "^0.0.11",
        "fastify": "^5.12.8",
        "fastify-plugin": "^6.0.1",
        "form-data": "^4.0.6",
        "mailgun.js": "^14.1.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.0.0",
        "@typescript-eslint/eslint-plugin": "^8.74.0",
        "@typescript-eslint/parser": "^8.74.0",
        "cpx2": "^9.1.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.15.0",
        "nodemon": "^3.1.14",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.74.0"
    }
}
